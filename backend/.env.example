# ── Database ────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./agneyaa.db

# ── Google Gemini AI ────────────────────────────────────────────
GEMINI_API_KEY=

# ── Google OAuth (for Sign In) ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App Settings ────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Server ──────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
